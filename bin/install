#!/bin/sh
# Usage: bin/install sync        (every Mac)
#        bin/install center      (the always-on Mac; also runs sync)
set -eu
cd "$(dirname "$0")/.."
REPO=$(pwd)

load_agent() {
  mkdir -p ~/Library/LaunchAgents ~/Library/Logs
  sed "s|__HOME__|$HOME|g; s|__REPO__|$REPO|g" "launch/$1.plist" > ~/Library/LaunchAgents/"$1.plist"
  launchctl bootout "gui/$(id -u)/$1" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" ~/Library/LaunchAgents/"$1.plist"
  echo "loaded $1"
}

case "${1:-}" in
  center)
    (cd center && bundle install --quiet)
    load_agent com.ikraam.tailclip.center
    tailscale serve --bg --https=8443 http://127.0.0.1:8788 >/dev/null
    echo "center at https://$(tailscale status --json | python3 -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))'):8443"
    "$0" sync
    ;;
  sync)
    (cd sync && swift build -c release 2>&1 | tail -1)
    mkdir -p ~/.local/bin
    cp sync/.build/release/tailclip-sync ~/.local/bin/tailclip-sync
    load_agent com.ikraam.tailclip.sync
    ;;
  *) sed -n '2,3p' "$0"; exit 1 ;;
esac
