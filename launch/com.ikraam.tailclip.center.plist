<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ikraam.tailclip.center</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BUNDLE__</string>
    <string>exec</string><string>puma</string>
    <string>-b</string><string>tcp://127.0.0.1:8788</string>
    <string>config.ru</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__/center</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>__HOME__</string>
    <key>RACK_ENV</key><string>production</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/tailclip-center.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/tailclip-center.log</string>
</dict>
</plist>
